<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Every app extension runs sandboxed; Quick Look grants it read
	     access to the one file being previewed, and nothing else is
	     needed: the engine reads that file into an in-memory DuckDB, with
	     extension downloads switched off. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
