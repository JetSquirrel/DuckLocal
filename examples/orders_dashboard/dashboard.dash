// A dashboard over orders.csv. Check it from anywhere:
//
//   ducklocal check examples/orders_dashboard/dashboard.dash
//
// or open it as a dashboard tab in the GUI:
//
//   ducklocal examples/orders_dashboard/dashboard.dash
//
// The source's path is relative to this file, so the spec and its data move
// together; the queries read it by name.

source "orders" {
  path = "orders.csv"
}

query "totals" {
  sql = <<SQL
    SELECT sum(revenue) AS revenue, sum(orders) AS orders,
           count(DISTINCT channel) AS channels,
           count(DISTINCT region) || ' regions, ' || count(DISTINCT date) || ' days' AS spread
    FROM orders
    WHERE $channel
  SQL
}

// The busiest day, and the day it was, for one card: the number is the
// value, the day its note.
query "busiest" {
  sql = <<SQL
    SELECT sum(orders) AS orders, strftime(date, '%a, %b %-d') AS day
    FROM orders
    WHERE $channel
    GROUP BY date
    ORDER BY orders DESC
    LIMIT 1
  SQL
}

query "revenue_by_channel" {
  sql = <<SQL
    SELECT channel, sum(revenue) AS revenue
    FROM orders
    GROUP BY channel
    ORDER BY revenue DESC
  SQL
}

query "daily_orders" {
  sql = <<SQL
    SELECT date, channel, sum(orders) AS orders
    FROM orders
    WHERE $channel
    GROUP BY date, channel
    ORDER BY date, channel
  SQL
}

// A text panel heads the dashboard; it runs no query.
plot "overview" {
  type  = "text"
  title = "Orders overview"
  text  = "Five channels, three regions, September 2026"
}

plot "revenue_total" {
  type  = "card"
  query = query.totals
  value = revenue
  title = "Revenue"
  note  = "Every channel and region"
  tone  = "accent"
}

plot "orders_total" {
  type  = "card"
  query = query.totals
  value = orders
  title = "Orders"
  note  = spread
}

// A note that names a column shows that column's value from the card's row.
plot "busiest_day" {
  type  = "card"
  query = query.busiest
  value = orders
  title = "Busiest day"
  note  = day
  tone  = "warning"
}

plot "channels" {
  type  = "card"
  query = query.totals
  value = channels
  title = "Channels"
}

plot "revenue" {
  type  = "bar"
  query = query.revenue_by_channel
  x     = channel
  y     = revenue
  title = "Revenue by channel"
  width = 6
}

// One line per channel, each in its own colour, with a key above.
plot "orders" {
  type   = "line"
  query  = query.daily_orders
  x      = date
  y      = orders
  series = channel
  title  = "Orders per day"
  width  = 6
}

// A click on a revenue bar narrows the cards and the daily orders to that
// channel; the bar chart itself stays whole, so another bar can be picked.
// Nothing picked, `$channel` is TRUE.
filter "channel" {
  plot = plot.revenue
}
